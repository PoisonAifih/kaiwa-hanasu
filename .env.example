# One server-side key for chat, correction, TTS and STT. Never put it in the frontend.
OPENROUTER_API_KEY=

OPENROUTER_CHAT_MODEL=google/gemini-2.5-flash
# Empty = use OPENROUTER_CHAT_MODEL for the correction pass too
OPENROUTER_CORRECTION_MODEL=

# Gemini TTS returns raw PCM (24 kHz mono); it is streamed to the browser as-is.
# Other voices: Puck, Charon, Fenrir, Aoede, ...
OPENROUTER_TTS_MODEL=google/gemini-3.8-flash-lite-tts
OPENROUTER_TTS_VOICE=Kore

# openai/whisper-large-v3 also works but is about 3x slower
OPENROUTER_STT_MODEL=openai/gpt-4o-mini-transcribe
OPENROUTER_STT_LANGUAGE=ja

MAX_AUDIO_BYTES=10485760
MAX_HISTORY_MESSAGES=20
CORS_ORIGINS=http://localhost:5173
